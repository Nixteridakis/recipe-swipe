# @sensitive=false
NEXT_PUBLIC_SANITY_PROJECT_ID=

# @sensitive=false
NEXT_PUBLIC_SANITY_DATASET=production

# @required=false
SANITY_WRITE_TOKEN=

# Public site URL (https://your-app.netlify.app). Used when building the extension zip (pnpm run build).
# @required=false
# @sensitive=false
NEXT_PUBLIC_APP_URL=

# Local app URL for manual extension testing (default http://localhost:3000). Used only by pnpm run zip:extension.
# @required=false
# @sensitive=false
NEXT_LOCAL_APP_URL=
