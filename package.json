{
  "name": "recipe-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "varlock run -- next dev --webpack",
    "build": "varlock run -- sh -c \"next build && EXTENSION_ZIP_MODE=production pnpm run zip:extension\"",
    "start": "varlock run -- next start",
    "lint": "eslint",
    "env:check": "varlock load",
    "zip:extension": "node scripts/generate-extension-api-base.mjs && mkdir -p public/downloads && cd chrome-extension && zip -r ../public/downloads/brasserie-recipe-importer.zip . -x '*.DS_Store'"
  },
  "overrides": {
    "next": {
      "@next/env": "npm:@varlock/nextjs-integration"
    }
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.15.0",
    "@varlock/nextjs-integration": "^1.2.2",
    "next": "16.3.5",
    "next-sanity": "^13.3.4",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.15.0",
    "styled-components": "^6.5.3",
    "swiper": "^14.2.0",
    "varlock": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "sass": "^1.104.1",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.30.3"
}
