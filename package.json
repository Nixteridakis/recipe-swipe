{
  "name": "recipe-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "varlock run -- next dev --webpack",
    "build": "varlock run -- sh -c \"next build && EXTENSION_ZIP_MODE=production pnpm run zip:extension\"",
    "start": "varlock run -- next start",
    "lint": "eslint",
    "env:check": "varlock load",
    "zip:extension": "node scripts/generate-extension-api-base.mjs && mkdir -p public/downloads && cd chrome-extension && zip -r ../public/downloads/brasserie-recipe-importer.zip . -x '*.DS_Store'"
  },
  "overrides": {
    "next": {
      "@next/env": "npm:@varlock/nextjs-integration"
    }
  },
  "dependencies": {
    "@portabletext/react": "^6.0.3",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^4.22.0",
    "@varlock/nextjs-integration": "^0.3.0",
    "next": "16.1.1",
    "next-sanity": "^11.6.12",
    "postcss": "^8.5.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanity": "^4.22.0",
    "styled-components": "^6.1.19",
    "swiper": "^12.1.3",
    "varlock": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "sass": "^1.98.0",
    "typescript": "^5"
  }
}
